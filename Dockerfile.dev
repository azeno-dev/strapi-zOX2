FROM node:20-alpine

# Install build dependencies for native modules and sharp
RUN apk update && apk add --no-cache build-base gcc autoconf automake libtool zlib-dev libpng-dev nasm vips-dev git

WORKDIR /opt/app

COPY package.json yarn.lock ./
RUN yarn install

COPY . .

ENV NODE_ENV=development
EXPOSE 1337

CMD ["yarn", "develop"]
